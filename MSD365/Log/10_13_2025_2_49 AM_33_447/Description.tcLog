		<Prp name="warning count" type="I" value="0"/>
		<Prp name="completed" type="B" value="0"/>
		<Prp name="status" type="I" value="2"/>
		<Prp name="user name" type="S" value="svc-p-azureagent"/>
		<Prp name="start time" type="D" value="45943.1177482292"/>
		<Prp name="error count" type="I" value="2"/>
	</Node>
</Nodes>